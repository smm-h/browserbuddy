{
  "manifest_version": 3,
  "name": "BrowserBuddy",
  "version": "0.2.0",
  "description": "Streams your browsing activity to the local BrowserBuddy MCP server and lets the paired AI assistant act in your browser.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "webNavigation",
    "downloads",
    "scripting",
    "storage",
    "activeTab",
    "clipboardWrite",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["transport-native.js", "background.js"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:*"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browserbuddy@localhost",
      "strict_min_version": "128.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "BrowserBuddy"
  }
}
