{
  "publish_mode": "ci",
  "targets": [
    "npm",
    {
      "name": "pypi",
      "path": "pypi"
    }
  ],
  "pipelines": {
    "npm": {
      "type": "npm",
      "local": false,
      "provenance": true,
      "target": "npm"
    },
    "pypi": {
      "type": "pypi",
      "local": false,
      "target": "pypi"
    }
  },
  "changelog_format_version_enforced": true,
  "external_checks": [
    {
      "name": "manifest-version-lockstep",
      "kind": "freeform",
      "command": "node scripts/check-manifest-version.mjs",
      "tag": "preflight"
    }
  ]
}
